/*
  # Transport / misc
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin

  # Clickjacking
  X-Frame-Options: DENY

  # Permissions
  Permissions-Policy: camera=(), microphone=(), geolocation=(), clipboard-read=(), clipboard-write=()

  # CSP (минимум, без inline-скриптов)
  Content-Security-Policy: default-src 'self'; script-src 'self' https://telegram.org https://cdn.jsdelivr.net; style-src 'self' https://cdn.jsdelivr.net 'unsafe-inline'; img-src 'self' data: blob: https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; connect-src 'self' https://cdn.jsdelivr.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests